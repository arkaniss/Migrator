@inherits LayoutComponentBase
<div class="page @(sidebarCollapsed ? "sidebar-collapsed" : null)">
    <div class="sidebar">
        <NavMenu SidebarCollapsed="sidebarCollapsed" OnToggleSidebar="ToggleSidebar" />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="text-muted">Blazor WebAssembly · SQL Server</span>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool sidebarCollapsed;

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }
}
