        var entry = savedConnections.FirstOrDefault(x => x.Id == id);
        if (entry is null || entry.Connection is null)
        {
            return;
        }

        plan.Target = CloneConn(entry.Connection);
        activeTargetConnectionId = entry.Id;
        registry.TargetConnectionId = entry.Id;
        entry.LastUsedAt = DateTimeOffset.UtcNow;
        await PersistSavedConnectionsAsync();
        statusMessage = $"Destino rellenado desde: {entry.Name}";
