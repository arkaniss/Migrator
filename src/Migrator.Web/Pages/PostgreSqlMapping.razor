    private List<TableMapping> GetSelectedMappings() =>
        plan.Tables.Where(t => selectedForRun.Contains(t.Source)).ToList();

    private async Task ExecuteBatchAsync(bool dryRun)
    {
        if (!dryRun && !await Js.InvokeAsync<bool>("confirm", "¿Ejecutar migración REAL en el destino para las tablas seleccionadas?"))
        {
            return;
        }

        var tables = GetSelectedMappings();
        if (tables.Count == 0)
        {
            statusMessage = "Selecciona al menos una tabla en el plan.";
            return;
        }

        var body = ClonePlanSubset(tables);
        await PostExecuteAndMergeAsync(body, dryRun, "lote");
    }

    private async Task ExecuteSequentialAsync(bool dryRun)
    {
        if (!dryRun && !await Js.InvokeAsync<bool>("confirm", "¿Ejecutar migración REAL tabla por tabla en el destino?"))
        {
            return;
        }

        var tables = GetSelectedMappings();
        if (tables.Count == 0)
        {
            statusMessage = "Selecciona al menos una tabla en el plan.";
            return;
        }

        var client = HttpFactory.CreateClient("MigratorApi");
        var sb = new System.Text.StringBuilder();

        foreach (var table in tables)
        {
            var body = ClonePlanSubset(new List<TableMapping> { table });
            var resp = await client.PostAsJsonAsync($"api/migration/execute?dryRun={JsonBool(dryRun)}", body);
            var raw = await resp.Content.ReadAsStringAsync();
            MigrationExecutionSummary? summary = null;
            try
            {
                summary = JsonSerializer.Deserialize<MigrationExecutionSummary>(raw, JsonRead);
            }
            catch
            {
                sb.AppendLine($"{table.Source}: respuesta no válida ({resp.StatusCode}).");
                continue;
            }

            if (summary is null)
            {
                continue;
            }

            MergeRunResults(summary, dryRun);
            await registry.TryRecordExecutionAsync(plan, summary, dryRun);
            foreach (var row in summary.Tables ?? Array.Empty<TableMigrationResult>())
            {
                sb.AppendLine($"{row.Source}: {(row.Error is null ? $"OK, filas {row.RowsRead}" : row.Error)}");
            }
        }

        await PersistRunStateAsync();
        await registry.RefreshLastProgressAndHistoryAsync();

        statusMessage = "Ejecución uno a uno:\n" + sb;
        StateHasChanged();
    }

    private static string JsonBool(bool v) => v ? "true" : "false";

    private MigrationPlan ClonePlanSubset(List<TableMapping> tables) =>
        new()
        {
            SourceKind = "postgresql",
            PostgreSqlSource = plan.PostgreSqlSource is null ? new PostgreSqlConnectionInfo() : ClonePostgreSql(plan.PostgreSqlSource),
            Source = new SqlServerConnectionInfo(),
            Target = CloneConn(plan.Target),
            Tables = tables.Select(t => new TableMapping
            {
                Source = t.Source,
                Target = t.Target,
                Mode = t.Mode,
                ReseedToZero = t.ReseedToZero,
                PreserveIdentityValues = t.PreserveIdentityValues,
                KeyColumns = t.KeyColumns.ToList(),
                Columns = t.Columns.Select(c => new ColumnMapping
                {
                    Source = c.Source,
                    Target = c.Target,
                    SourceExpression = c.SourceExpression,
                }).ToList(),
            }).ToList(),
        };

    private static SqlServerConnectionInfo CloneConn(SqlServerConnectionInfo c) =>
        new()
        {
            Server = c.Server,
            Database = c.Database,
            IntegratedSecurity = c.IntegratedSecurity,
            UserId = c.UserId,
            Password = c.Password,
            TrustServerCertificate = c.TrustServerCertificate,
            Encrypt = c.Encrypt,
        };

    private async Task PostExecuteAndMergeAsync(MigrationPlan body, bool dryRun, string modeLabel)
    {
        statusMessage = null;
        try
        {
            var client = HttpFactory.CreateClient("MigratorApi");
            var resp = await client.PostAsJsonAsync($"api/migration/execute?dryRun={JsonBool(dryRun)}", body);
            var raw = await resp.Content.ReadAsStringAsync();
            var summary = JsonSerializer.Deserialize<MigrationExecutionSummary>(raw, JsonRead);
            if (summary is null)
            {
                statusMessage = "No se pudo interpretar la respuesta de la API.";
                return;
            }

            MergeRunResults(summary, dryRun);
            await registry.TryRecordExecutionAsync(plan, summary, dryRun);
            await PersistRunStateAsync();
            await registry.RefreshLastProgressAndHistoryAsync();

            var lines = (summary.Tables ?? Array.Empty<TableMigrationResult>()).Select(t =>
                $"{t.Source}: {(t.Error is null ? $"filas leídas {t.RowsRead}" : t.Error)}");
            statusMessage = $"Ejecución ({modeLabel}) — éxito global: {summary.Success}\n" + string.Join("\n", lines);
            if (summary.GlobalErrors is { Count: > 0 })
            {
                statusMessage += "\nErrores globales:\n" + string.Join("\n", summary.GlobalErrors);
            }
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
        }
    }

    private string? RegistryCssForMapping(TableMapping t) => registry.CssForPair(t.Source, t.Target);

    private string? RegistryCssForDraftSourceOption(string qualifiedName)
    {
        var m = plan.Tables.FirstOrDefault(x => string.Equals(x.Source, qualifiedName, StringComparison.OrdinalIgnoreCase));
        return m is null ? null : registry.CssForPair(m.Source, m.Target);
    }

    private string? RegistryCssForDraftTargetOption(string qualifiedName)
    {
        if (string.IsNullOrWhiteSpace(draftSource))
        {
            return null;
        }

        var m = plan.Tables.FirstOrDefault(x =>
            string.Equals(x.Source, draftSource, StringComparison.OrdinalIgnoreCase)
            && string.Equals(x.Target, qualifiedName, StringComparison.OrdinalIgnoreCase));
        return m is null ? null : registry.CssForPair(m.Source, m.Target);
    }

    private void MergeRunResults(MigrationExecutionSummary summary, bool dryRun)
    {
        foreach (var row in summary.Tables ?? Array.Empty<TableMigrationResult>())
        {
            var ok = row.Error is null;
            lastRunBySource[row.Source] = new TableRunState
            {
                At = DateTimeOffset.UtcNow,
                Success = ok,
                DryRun = dryRun,
                Message = row.Error ?? $"Filas: {row.RowsRead}",
            };

            sessionRunLog.Add(new TableRunLogEntry
            {
                At = DateTimeOffset.UtcNow,
                DryRun = dryRun,
                Source = row.Source,
                Success = ok,
                Details = row.Error ?? $"Filas leídas: {row.RowsRead}",
            });
        }
    }

    private async Task SaveSnapshotAsync()
    {
        if (string.IsNullOrWhiteSpace(snapshotName) || plan.Tables.Count == 0)
        {
            return;
        }

        var envelope = new PlanSnapshotEnvelope
        {
            Name = snapshotName.Trim(),
            SavedAt = DateTimeOffset.UtcNow,
            Plan = MigrationPlanJson.Deserialize(MigrationPlanJson.Serialize(plan)),
            RunLog = sessionRunLog.TakeLast(100).ToList(),
        };

        snapshots.Add(envelope);
        await PersistSnapshotsAsync();
        snapshotName = string.Empty;
        statusMessage = $"Snapshot guardado: {envelope.Name}";
    }

    private async Task LoadSnapshotAsync(string id)
    {
        var s = snapshots.FirstOrDefault(x => x.Id == id);
        if (s is null)
        {
            return;
        }

        var clone = MigrationPlanJson.Deserialize(MigrationPlanJson.Serialize(s.Plan));
        plan.SourceKind = "postgresql";
        plan.PostgreSqlSource = clone.PostgreSqlSource is null ? new PostgreSqlConnectionInfo() : ClonePostgreSql(clone.PostgreSqlSource);
        plan.Source = clone.Source ?? new SqlServerConnectionInfo();
        plan.Target = clone.Target ?? new SqlServerConnectionInfo();
        plan.Tables.Clear();
        plan.Tables.AddRange(clone.Tables);

        sessionRunLog.Clear();
        sessionRunLog.AddRange(s.RunLog);

        selectedForRun.Clear();
        foreach (var t in plan.Tables)
        {
            selectedForRun.Add(t.Source);
        }

        sourceTables = new List<SchemaTableDto>();
        targetTables = new List<SchemaTableDto>();
        sourceColumns = new List<SchemaColumnDto>();
        targetColumns = new List<SchemaColumnDto>();

        statusMessage = $"Snapshot cargado: {s.Name}";
        await Task.CompletedTask;
    }

    private async Task DeleteSnapshotAsync(string id)
    {
        snapshots.RemoveAll(x => x.Id == id);
        await PersistSnapshotsAsync();
        statusMessage = "Snapshot eliminado.";
    }

    private async Task LoadSourceTablesAsync()
    {
        sourceLoadError = null;
        if (plan.PostgreSqlSource is null)
        {
            sourceLoadError = "No hay datos de conexión PostgreSQL.";
            return;
        }

        var (tables, err) = await FetchPostgreSqlTablesAsync(plan.PostgreSqlSource);
        sourceTables = tables;
        sourceLoadError = err;
        if (err is null)
        {
            activeSourceConnectionId = UpsertPostgreSqlConnectionFromUsage(plan.PostgreSqlSource);
            registry.SourceConnectionId = activeSourceConnectionId;
            await PersistSavedConnectionsAsync();
            registry.NotifySourceTablesLoaded(sourceTables.Count > 0);
            await registry.TryResolveByEndpointsAsync(plan);
            await registry.RefreshLastProgressAndHistoryAsync();
        }
    }

    private async Task LoadTargetTablesAsync()
    {
        targetLoadError = null;
        var (tables, err) = await FetchTablesAsync(plan.Target);
        targetTables = tables;
        targetLoadError = err;
        if (err is null)
        {
            activeTargetConnectionId = UpsertConnectionFromUsage(plan.Target);
            registry.TargetConnectionId = activeTargetConnectionId;
            await PersistSavedConnectionsAsync();
            registry.NotifyTargetTablesLoaded(targetTables.Count > 0);
            await registry.TryResolveByEndpointsAsync(plan);
            await registry.RefreshLastProgressAndHistoryAsync();
        }
    }

    private async Task<(List<SchemaTableDto> Tables, string? Error)> FetchTablesAsync(SqlServerConnectionInfo connection)
    {
        try
        {
            var client = HttpFactory.CreateClient("MigratorApi");
            var response = await client.PostAsJsonAsync("api/migration/metadata/tables", new MetadataTablesRequest(connection));
            if (!response.IsSuccessStatusCode)
            {
                return (new List<SchemaTableDto>(), await response.Content.ReadAsStringAsync());
            }

            var payload = await response.Content.ReadFromJsonAsync<MetadataTablesResponse>(JsonRead);
            return (payload?.Tables?.ToList() ?? new List<SchemaTableDto>(), null);
        }
        catch (Exception ex)
        {
            return (new List<SchemaTableDto>(), ex.Message);
        }
    }

    private async Task<(List<SchemaTableDto> Tables, string? Error)> FetchPostgreSqlTablesAsync(PostgreSqlConnectionInfo connection)
    {
        try
        {
            var client = HttpFactory.CreateClient("MigratorApi");
            var response = await client.PostAsJsonAsync(
                "api/migration/postgresql/metadata/tables",
                new PostgresqlMetadataTablesRequest(connection));
            if (!response.IsSuccessStatusCode)
            {
                return (new List<SchemaTableDto>(), await response.Content.ReadAsStringAsync());
            }

            var payload = await response.Content.ReadFromJsonAsync<MetadataTablesResponse>(JsonRead);
            return (payload?.Tables?.ToList() ?? new List<SchemaTableDto>(), null);
        }
        catch (Exception ex)
        {
            return (new List<SchemaTableDto>(), ex.Message);
        }
    }

    private async Task LoadDraftColumnsAsync()
    {
        statusMessage = null;
        sourceColumns = new List<SchemaColumnDto>();
        targetColumns = new List<SchemaColumnDto>();

        if (string.IsNullOrWhiteSpace(draftSource) || string.IsNullOrWhiteSpace(draftTarget))
        {
            statusMessage = "Selecciona tabla origen y destino.";
            return;
        }

        if (plan.PostgreSqlSource is null)
        {
            statusMessage = "Configura la conexión PostgreSQL de origen.";
            return;
        }

        try
        {
            var client = HttpFactory.CreateClient("MigratorApi");
            var srcResp = await client.PostAsJsonAsync(
                "api/migration/postgresql/metadata/columns",
                new PostgresqlMetadataColumnsRequest(plan.PostgreSqlSource!, draftSource));

            if (!srcResp.IsSuccessStatusCode)
            {
                statusMessage = "Origen columnas: " + await srcResp.Content.ReadAsStringAsync();
                return;
            }

            var srcPayload = await srcResp.Content.ReadFromJsonAsync<MetadataColumnsResponse>(JsonRead);
            sourceColumns = srcPayload?.Columns?.ToList() ?? new List<SchemaColumnDto>();

            var tgtResp = await client.PostAsJsonAsync(
                "api/migration/metadata/columns",
                new MetadataColumnsRequest(plan.Target, draftTarget));

            if (!tgtResp.IsSuccessStatusCode)
            {
                statusMessage = "Destino columnas: " + await tgtResp.Content.ReadAsStringAsync();
                sourceColumns = new List<SchemaColumnDto>();
                return;
            }

            var tgtPayload = await tgtResp.Content.ReadFromJsonAsync<MetadataColumnsResponse>(JsonRead);
            targetColumns = tgtPayload?.Columns?.ToList() ?? new List<SchemaColumnDto>();

            statusMessage = $"Columnas cargadas: {sourceColumns.Count} origen, {targetColumns.Count} destino.";
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
        }
    }

    private void SuggestByName()
    {
        columnRows.Clear();
        foreach (var t in targetColumns)
        {
            var match = sourceColumns.FirstOrDefault(s =>
                string.Equals(s.Name, t.Name, StringComparison.OrdinalIgnoreCase));
            columnRows.Add(new ColumnRow
            {
                Source = match?.Name ?? string.Empty,
                Target = t.Name,
                SourceExpression = string.Empty,
            });
        }

        if (columnRows.Count == 0)
        {
            columnRows.Add(new ColumnRow());
            columnRows.Add(new ColumnRow());
        }

        statusMessage =
            "Mapeo sugerido: una fila por columna destino (orden de inserción). Origen vacío si no hay homónima en PostgreSQL; rellena la transformación con un literal o expresión.";
    }

    private void ApplyConvertVarcharTemplate(int index)
    {
        var c = columnRows[index].Source.Trim();
        if (string.IsNullOrEmpty(c))
        {
            statusMessage = "Elige o escribe primero la columna origen.";
            return;
        }

        var b = PgQuoteIdentifier(c);
        columnRows[index].SourceExpression = $"CAST(s.{b} AS VARCHAR(50))";
        statusMessage = "Plantilla CAST aplicada (ajusta tipo y longitud).";
    }

    private void ApplyCaseTemplate(int index)
    {
        var c = columnRows[index].Source.Trim();
        if (string.IsNullOrEmpty(c))
        {
            statusMessage = "Elige o escribe primero la columna origen.";
            return;
        }

        var b = PgQuoteIdentifier(c);
        columnRows[index].SourceExpression = $"CASE WHEN s.{b} = 1 THEN 'Sí' ELSE 'No' END";
        statusMessage = "Plantilla CASE aplicada (ajusta condición y valores).";
    }

    private void ApplyCoalesceTemplate(int index)
    {
        var c = columnRows[index].Source.Trim();
        if (string.IsNullOrEmpty(c))
        {
            statusMessage = "Elige o escribe primero la columna origen.";
            return;
        }

        var b = PgQuoteIdentifier(c);
        columnRows[index].SourceExpression = $"COALESCE(s.{b}, '')";
        statusMessage = "Plantilla COALESCE: añade otra columna o literal como segundo argumento.";
    }

    private void ApplyGetDateTemplate(int index)
    {
        columnRows[index].SourceExpression = "NOW()";
        statusMessage = "Plantilla NOW() aplicada (fecha y hora actuales en PostgreSQL).";
    }

    private static string PgQuoteIdentifier(string name) =>
        "\"" + name.Replace("\"", "\"\"", StringComparison.Ordinal) + "\"";

    private void AddColumnRow() => columnRows.Add(new ColumnRow());

    private void RemoveColumnRow(int index)
    {
        if (columnRows.Count <= 1)
        {
            return;
        }

        columnRows.RemoveAt(index);
    }

    private void AddOrUpdateTable()
    {
        statusMessage = null;

        var keys = draftKeys
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(s => s.Length > 0)
            .ToList();

        foreach (var r in columnRows.Where(r => !string.IsNullOrWhiteSpace(r.Source) || !string.IsNullOrWhiteSpace(r.Target)))
        {
            var exprErr = SourceExpressionSyntax.Validate(r.SourceExpression);
            if (exprErr is not null)
            {
                statusMessage = $"Transformación SQL: {exprErr}";
                return;
            }
        }

        var cols = columnRows
            .Where(static r =>
                !string.IsNullOrWhiteSpace(r.Source)
                || (!string.IsNullOrWhiteSpace(r.Target) && !string.IsNullOrWhiteSpace(r.SourceExpression)))
            .Select(static r => new ColumnMapping
            {
                Source = string.IsNullOrWhiteSpace(r.Source) ? string.Empty : r.Source.Trim(),
                Target = string.IsNullOrWhiteSpace(r.Target)
                    ? (string.IsNullOrWhiteSpace(r.Source) ? string.Empty : r.Source.Trim())
                    : r.Target.Trim(),
                SourceExpression = string.IsNullOrWhiteSpace(r.SourceExpression) ? null : r.SourceExpression.Trim(),
            })
            .ToList();

        if (string.IsNullOrWhiteSpace(draftSource) || string.IsNullOrWhiteSpace(draftTarget))
        {
            statusMessage = "Indica tabla origen y destino.";
            return;
        }

        if (cols.Count == 0)
        {
            statusMessage = "Añade al menos un par de columnas.";
            return;
        }

        var mapping = new TableMapping
        {
            Source = draftSource.Trim(),
            Target = draftTarget.Trim(),
            Mode = draftMode,
            ReseedToZero = draftReseedToZero,
            PreserveIdentityValues = draftPreserveIdentityValues,
            KeyColumns = keys,
            Columns = cols,
        };

        var existing = plan.Tables.FindIndex(t =>
            string.Equals(t.Source, mapping.Source, StringComparison.OrdinalIgnoreCase));

        if (existing >= 0)
        {
            plan.Tables[existing] = mapping;
            statusMessage = "Tabla actualizada en el plan.";
        }
        else
        {
            plan.Tables.Add(mapping);
            statusMessage = "Tabla añadida al plan.";
        }

        selectedForRun.Add(mapping.Source);
    }

    private void ClearDraft()
    {
        draftSource = string.Empty;
        draftTarget = string.Empty;
        draftMode = "insert";
        draftKeys = string.Empty;
        draftReseedToZero = false;
        draftPreserveIdentityValues = false;
        columnRows.Clear();
        columnRows.Add(new());
        columnRows.Add(new());
        sourceColumns = new List<SchemaColumnDto>();
        targetColumns = new List<SchemaColumnDto>();
        statusMessage = "Borrador limpiado.";
    }

    private void RemoveTable(TableMapping t)
    {
        plan.Tables.Remove(t);
        selectedForRun.Remove(t.Source);
        lastRunBySource.Remove(t.Source);
        statusMessage = "Tabla eliminada del plan.";
    }

    private async Task DownloadPlan()
    {
        statusMessage = null;
        var json = MigrationPlanJson.Serialize(plan);
        await Js.InvokeVoidAsync("downloadTextFile", "mapeo-postgresql.json", json);
    }

    private async Task OnImportJson(InputFileChangeEventArgs e)
    {
        statusMessage = null;
        var file = e.File;
        if (file is null)
        {
            return;
        }

        await using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
        using var reader = new StreamReader(stream);
        var json = await reader.ReadToEndAsync();
        var imported = MigrationPlanJson.Deserialize(json);

        if (imported.UsesOracleSource())
        {
            statusMessage = "Este archivo es de migración Oracle → SQL Server. Ábrelo desde el menú Oracle.";
            return;
        }

        if (imported.UsesMySqlSource())
        {
            statusMessage = "Este archivo es de migración MySQL → SQL Server. Ábrelo desde el menú MySQL.";
            return;
        }

        if (!imported.UsesPostgresqlSource())
        {
            statusMessage = "Este JSON no es un plan PostgreSQL → SQL Server (sourceKind postgresql). Usa SQL Server, MySQL u Oracle para otros orígenes.";
            return;
        }

        plan.SourceKind = "postgresql";
        plan.PostgreSqlSource = imported.PostgreSqlSource is null ? new PostgreSqlConnectionInfo() : ClonePostgreSql(imported.PostgreSqlSource);
        plan.Source = imported.Source ?? new SqlServerConnectionInfo();
        plan.Target = imported.Target ?? new SqlServerConnectionInfo();
        plan.Tables.Clear();
        plan.Tables.AddRange(imported.Tables);

        selectedForRun.Clear();
        foreach (var t in plan.Tables)
        {
            selectedForRun.Add(t.Source);
        }

        sourceTables = new List<SchemaTableDto>();
        targetTables = new List<SchemaTableDto>();
        sourceColumns = new List<SchemaColumnDto>();
        targetColumns = new List<SchemaColumnDto>();
        sourceLoadError = null;
        targetLoadError = null;

        UpsertPostgreSqlConnectionFromUsage(plan.PostgreSqlSource);
        UpsertConnectionFromUsage(plan.Target);
        await PersistSavedConnectionsAsync();

        var draftLoaded = TryApplyDraftFromImportedPlan();
        var draftRowCount = columnRows.Count;
        if (draftLoaded && !string.IsNullOrWhiteSpace(draftSource) && !string.IsNullOrWhiteSpace(draftTarget))
        {
            await LoadDraftColumnsAsync();
        }

        statusMessage = draftLoaded
            ? $"Importado: {plan.Tables.Count} tabla(s). Borrador cargado para {draftSource} → {draftTarget} ({draftRowCount} filas) desde el JSON."
              + (string.IsNullOrWhiteSpace(statusMessage) ? string.Empty : $" {statusMessage}")
            : $"Importado: {plan.Tables.Count} tabla(s). Conexiones añadidas/actualizadas en la biblioteca. Marca cuáles ejecutar y usa dry-run antes del real.";
    }

    private bool TryApplyDraftFromImportedPlan()
    {
        if (string.IsNullOrWhiteSpace(draftSource) || string.IsNullOrWhiteSpace(draftTarget))
        {
            return false;
        }

        var match = plan.Tables.FirstOrDefault(t =>
            string.Equals(t.Source.Trim(), draftSource.Trim(), StringComparison.OrdinalIgnoreCase)
            && string.Equals(t.Target.Trim(), draftTarget.Trim(), StringComparison.OrdinalIgnoreCase));

        if (match is null)
        {
            return false;
        }

        ApplyDraftFromTableMapping(match);
        return true;
    }

    private async Task OnLoadTableFromRegistryProgressAsync(RegistryTableProgressDto progress)
    {
        var mapping = RegistryProgressTableLoader.ResolveMapping(progress, plan);
        RegistryProgressTableLoader.MergeIntoPlan(mapping, plan);
        selectedForRun.Add(mapping.Source);
        ApplyDraftFromTableMapping(mapping);
        if (plan.PostgreSqlSource is not null
            && !string.IsNullOrWhiteSpace(plan.Target.Server)
            && !string.IsNullOrWhiteSpace(draftSource)
            && !string.IsNullOrWhiteSpace(draftTarget))
        {
            await LoadDraftColumnsAsync();
        }

        statusMessage =
            $"Tabla cargada desde registro ({RegistryMappingHost.StatusLabel(progress.Status)}): {mapping.Source} → {mapping.Target}. "
            + "Mapeo aplicado al borrador; puedes corregir columnas y volver a ejecutar.";
        StateHasChanged();
    }

    private void ApplyDraftFromTableMapping(TableMapping table)
    {
        draftSource = table.Source;
        draftTarget = table.Target;
        draftMode = string.IsNullOrWhiteSpace(table.Mode) ? "insert" : table.Mode.Trim();
        draftKeys = table.KeyColumns.Count == 0
            ? string.Empty
            : string.Join(", ", table.KeyColumns.Where(static k => !string.IsNullOrWhiteSpace(k)));
        draftReseedToZero = table.ReseedToZero;
        draftPreserveIdentityValues = table.PreserveIdentityValues;

        columnRows.Clear();
        foreach (var col in table.Columns)
        {
            columnRows.Add(new ColumnRow
            {
                Source = col.Source ?? string.Empty,
                Target = col.Target ?? string.Empty,
                SourceExpression = col.SourceExpression ?? string.Empty,
            });
        }

        if (columnRows.Count == 0)
        {
            columnRows.Add(new ColumnRow());
            columnRows.Add(new ColumnRow());
        }
    }

    private static string IdentityOptionsSuffix(TableMapping t)
    {
        if (!t.ReseedToZero && !t.PreserveIdentityValues)
        {
            return string.Empty;
        }

        var parts = new List<string>(2);
        if (t.ReseedToZero)
        {
            parts.Add("reseed identidad");
        }

        if (t.PreserveIdentityValues)
        {
            parts.Add("mantener IDENTITY");
        }

        return " · " + string.Join(", ", parts);
    }

    private sealed class ColumnRow
    {
        public string Source { get; set; } = string.Empty;

        public string Target { get; set; } = string.Empty;

        public string SourceExpression { get; set; } = string.Empty;
    }
}
