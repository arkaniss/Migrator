@page "/postgresql"
@using System.Net.Http.Json
@using System.Text.Json
@using Migrator.Core
@using Migrator.Web.Models
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

<PageTitle>Mapeo PostgreSQL → SQL Server</PageTitle>

<h1>Mapeo PostgreSQL → SQL Server</h1>

<p class="text-muted">
    El <strong>origen</strong> es PostgreSQL y el <strong>destino</strong> es SQL Server. Carga tablas/columnas vía <strong>Migrator.Api</strong> (<code>wwwroot/appsettings.json</code> → <code>MigratorApi</code>).
    Las tablas de origen usan el formato <code>esquema.tabla</code> devuelto por el servidor. Las conexiones guardadas comparten biblioteca con la página SQL Server y se filtran por tipo.
    Los snapshots de esta página son independientes (otra clave en <strong>localStorage</strong>).
</p>

<div class="row g-4 mb-3">
    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Origen</div>
            <div class="card-body">
                <label class="form-label small mb-0">Aplicar conexión guardada</label>
                <select class="form-select form-select-sm mb-2" @onchange="OnApplySourcePreset">
                    <option value="">— Elegir —</option>
                    @foreach (var s in PostgreSqlSavedConnections)
                    {
                        <option value="@s.Id">@FormatSavedConnectionLabel(s)</option>
                    }
                </select>
                <div class="input-group input-group-sm mb-2">
                    <InputText class="form-control" @bind-Value="newPresetNameSource" placeholder="Nombre al guardar (opc.)" />
                    <button type="button" class="btn btn-outline-secondary" @onclick="SaveSourceAsPresetAsync">Guardar</button>
                </div>
                <PostgreSqlConnectionFields Model="plan.PostgreSqlSource!" />
                <button type="button" class="btn btn-outline-primary btn-sm mt-2" @onclick="LoadSourceTablesAsync">Cargar tablas</button>
                @if (sourceLoadError is not null)
                {
                    <div class="text-danger small mt-2">@sourceLoadError</div>
                }
            </div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Destino</div>
            <div class="card-body">
                <label class="form-label small mb-0">Aplicar conexión guardada</label>
                <select class="form-select form-select-sm mb-2" @onchange="OnApplyTargetPreset">
                    <option value="">— Elegir —</option>
                    @foreach (var s in SqlServerSavedConnections)
                    {
                        <option value="@s.Id">@FormatSavedConnectionLabel(s)</option>
                    }
                </select>
                <div class="input-group input-group-sm mb-2">
                    <InputText class="form-control" @bind-Value="newPresetNameTarget" placeholder="Nombre al guardar (opc.)" />
                    <button type="button" class="btn btn-outline-secondary" @onclick="SaveTargetAsPresetAsync">Guardar</button>
                </div>
                <ConnectionFields Model="plan.Target" />
                <button type="button" class="btn btn-outline-primary btn-sm mt-2" @onclick="LoadTargetTablesAsync">Cargar tablas</button>
                @if (targetLoadError is not null)
                {
                    <div class="text-danger small mt-2">@targetLoadError</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Biblioteca de conexiones (<code>conexiones.json</code>)</div>
    <div class="card-body">
        <p class="small text-muted mb-2">
            Lista en <strong>este navegador</strong>. Se actualiza al guardar manualmente, al cargar tablas con éxito y al importar un <code>mapeo.json</code>.
            Las contraseñas se guardan en texto claro en el almacenamiento local: úsalo solo en entornos de confianza.
        </p>
        @if (savedConnections.Count == 0)
        {
            <p class="text-muted small mb-2">Aún no hay entradas. Usa <em>Guardar</em> en origen/destino o importa un JSON.</p>
        }
        else
        {
            <div class="table-responsive mb-3" style="max-height: 250px;overflow: auto;">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Nombre</th><th>Tipo</th><th>Servidor</th><th>Base</th><th>Último uso</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var s in savedConnections.OrderByDescending(x => x.LastUsedAt))
                    {
                        <tr>
                            <td>@s.Name</td>
                            <td><span class="badge bg-secondary">@SavedConnectionKindLabel(s)</span></td>
                            <td><code>@SavedConnectionServer(s)</code></td>
                            <td><code>@SavedConnectionDatabase(s)</code></td>
                            <td class="small">@s.LastUsedAt.ToLocalTime().ToString("g")</td>
                            <td class="text-nowrap">
                                @if (IsPostgreSqlSaved(s))
                                {
                                    <button type="button" class="btn btn-link btn-sm py-0" @onclick="async () => await ApplyPresetToSourceAsync(s)">→ Origen</button>
                                }
                                @if (IsSqlServerSaved(s))
                                {
                                    <button type="button" class="btn btn-link btn-sm py-0" @onclick="async () => await ApplyPresetToTargetAsync(s)">→ Destino</button>
                                }
                                <button type="button" class="btn btn-link btn-sm text-danger py-0" @onclick="async () => await DeleteSavedConnectionAsync(s.Id)">Quitar</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-success btn-sm" @onclick="DownloadConnectionsJsonAsync" disabled="@(savedConnections.Count == 0)">Descargar conexiones.json</button>
            <label class="btn btn-outline-primary btn-sm mb-0">
                Importar JSON
                <InputFile OnChange="OnImportConnectionsJson" accept=".json,application/json" class="d-none" />
            </label>
            <a class="btn btn-outline-secondary btn-sm" href="conexiones.ejemplo.json" download="conexiones.ejemplo.json">Descargar plantilla de ejemplo</a>
        </div>
    </div>
</div>

@if (GetPendingSourceTables().Count > 0)
{
    <div class="alert alert-light border mb-3" style="max-height: 250px;overflow: auto;">
        <strong>Tablas de origen aún sin mapeo en el plan</strong> (comparación con la última carga de metadatos):
        <ul class="mb-0 mt-2 small">
            @foreach (var p in GetPendingSourceTables())
            {
                <li>
                    <code>@p.QualifiedName</code>
                    <button type="button" class="btn btn-link btn-sm py-0" @onclick="() => UsePendingAsDraft(p.QualifiedName)">Usar en borrador</button>
                </li>
            }
        </ul>
    </div>
}

<h2 class="h5">Tabla en edición</h2>
<div class="card mb-3">
    <div class="card-body row g-3">
        <div class="col-md-6">
            <label class="form-label">Tabla origen</label>
            <InputSelect class="form-select" @bind-Value="draftSource">
                <option value="">— Elegir —</option>
                @foreach (var t in sourceTables)
                {
                    <option value="@t.QualifiedName" class="@RegistryCssForDraftSourceOption(t.QualifiedName)">@t.QualifiedName</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-6">
            <label class="form-label">Tabla destino</label>
            <InputSelect class="form-select" @bind-Value="draftTarget">
                <option value="">— Elegir —</option>
                @foreach (var t in targetTables)
                {
                    <option value="@t.QualifiedName" class="@RegistryCssForDraftTargetOption(t.QualifiedName)">@t.QualifiedName</option>
                }
            </InputSelect>
        </div>
        <div class="col-12">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LoadDraftColumnsAsync" disabled="@(string.IsNullOrWhiteSpace(draftSource) || string.IsNullOrWhiteSpace(draftTarget))">Cargar columnas</button>
            <button type="button" class="btn btn-outline-secondary btn-sm ms-2" @onclick="SuggestByName" disabled="@(sourceColumns.Count == 0 || targetColumns.Count == 0)">Sugerir mapeo por nombre</button>
        </div>
        <div class="col-md-3">
            <label class="form-label">Modo</label>
            <InputSelect class="form-select" @bind-Value="draftMode">
                <option value="insert">insert</option>
                <option value="upsert">upsert</option>
                <option value="truncateReload">truncateReload</option>
            </InputSelect>
        </div>
        <div class="col-md-4">
            <label class="form-label">Columnas clave (coma; nombres en <strong>origen</strong>, modo upsert)</label>
            <InputText class="form-control" @bind-Value="draftKeys" placeholder="IdCliente, codigo" />
        </div>
        <div class="col-md-5 d-flex align-items-end">
            <div class="d-flex flex-column gap-2 w-100">
                <div class="form-check mb-0">
                    <InputCheckbox class="form-check-input" id="reseed0" @bind-Value="draftReseedToZero" />
                    <label class="form-check-label" for="reseed0">Reseed identidad a 1 (destino)</label>
                </div>
                <div class="form-check mb-0">
                    <InputCheckbox class="form-check-input" id="preserveIdentity" @bind-Value="draftPreserveIdentityValues" />
                    <label class="form-check-label" for="preserveIdentity">Mantener valores IDENTITY (insert / truncateReload / upsert)</label>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body row g-3 mb-3">
        <div class="row mb-2">
            <div class="col-12 d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h3 class="h6 mt-3 mb-0">Mapeo de columnas</h3>
                    <p class="small text-muted mb-0">
                        La tabla origen usa el alias <code>s</code>. Sin transformación se usa <code>s."columna"</code> (PostgreSQL: identificador entre comillas dobles).
                        También <code>COALESCE</code>, <code>NULLIF</code>, <code>CAST</code>, <code>CASE</code>, <code>to_char</code> / <code>::tipo</code>, etc.
                    </p>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddColumnRow">+ Fila</button>
            </div>
        </div>
        <div class="row small fw-semibold text-muted mb-1 d-none d-md-flex gx-2 border-bottom">
            <div class="col-md-3">Campo origen</div>
            <div class="col-md-4">Transformación SQL</div>
            <div class="col-md-3">Campo destino</div>
            <div class="col-md-2"></div>
        </div>

        @for (var i = 0; i < columnRows.Count; i++)
        {
            var index = i;
            <div class="row g-2 mb-3 border-bottom pb-3 align-items-start div-bottom-separator">
                <div class="col-12 col-md-3">
                    <label class="form-label small mb-0">Campo origen</label>
                    @if (sourceColumns.Count > 0)
                    {
                        <InputSelect class="form-select form-select-sm" @bind-Value="columnRows[index].Source">
                            <option value="">—</option>
                            @foreach (var c in sourceColumns)
                            {
                                <option value="@c.Name">@c.Name (@c.DataType)</option>
                            }
                        </InputSelect>
                    }
                    else
                    {
                        <InputText class="form-control form-control-sm" placeholder="IdCliente" @bind-Value="columnRows[index].Source" />
                    }
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small mb-0">Transformación (opcional)</label>
                    <InputTextArea class="form-control form-control-sm font-monospace" rows="1"
                                   @bind-Value="columnRows[index].SourceExpression"
                                   placeholder="Ej: COALESCE(s.&quot;fecha&quot;, TIMESTAMP '1970-01-01')&#10;CAST(s.&quot;codigo&quot; AS VARCHAR(50))&#10;CASE WHEN s.&quot;activo&quot; THEN 'Sí' ELSE 'No' END" />
                    <div class="btn-group btn-group-sm mt-1 flex-wrap" role="group">
                        <button type="button" class="btn btn-outline-secondary" title="COALESCE (equivalente a IFNULL)" @onclick="() => ApplyCoalesceTemplate(index)">COALESCE</button>
                        <button type="button" class="btn btn-outline-secondary" title="CAST a VARCHAR" @onclick="() => ApplyConvertVarcharTemplate(index)">CAST</button>
                        <button type="button" class="btn btn-outline-secondary" title="CASE WHEN simple" @onclick="() => ApplyCaseTemplate(index)">CASE</button>
                        <button type="button" class="btn btn-outline-secondary" title="Fecha y hora actuales (transaction_timestamp / NOW)" @onclick="() => ApplyGetDateTemplate(index)">NOW</button>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small mb-0">Campo destino</label>
                    @if (targetColumns.Count > 0)
                    {
                        <InputSelect class="form-select form-select-sm" @bind-Value="columnRows[index].Target">
                            <option value="">—</option>
                            @foreach (var c in targetColumns)
                            {
                                <option value="@c.Name">@c.Name (@c.DataType)</option>
                            }
                        </InputSelect>
                    }
                    else
                    {
                        <InputText class="form-control form-control-sm" placeholder="clienteId" @bind-Value="columnRows[index].Target" />
                    }
                </div>
                <div class="col-12 col-md-2 d-flex align-items-end">
                    @if (columnRows.Count > 1)
                    {
                        <button type="button" class="btn btn-outline-danger w-100" @onclick="() => RemoveColumnRow(index)">Quitar</button>
                    }
                </div>
            </div>
        }

    </div>

</div>

<div class="btn-toolbar gap-2 my-3">
    <button type="button" class="btn btn-primary" @onclick="AddOrUpdateTable">Guardar tabla en el plan</button>
    <button type="button" class="btn btn-outline-secondary" @onclick="ClearDraft">Limpiar borrador</button>
</div>

<h2 class="h5">Tablas en el plan (@plan.Tables.Count)</h2>
@if (plan.Tables.Count == 0)
{
    <p class="text-muted">Aún no hay tablas. Completa el borrador y pulsa <em>Guardar tabla en el plan</em>.</p>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-2 align-items-center">
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SelectAllForRun">Seleccionar todas</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SelectNoneForRun">Quitar selección</button>
        <span class="small text-muted">(@selectedForRun.Count seleccionadas)</span>
    </div>
    <ul class="list-group mb-3">
        @foreach (var (t, idx) in plan.Tables.Select((x, i) => (x, i)))
        {
            <li class="list-group-item">
                <div class="d-flex flex-wrap gap-2 align-items-start">
                    <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" id="@($"sel_{idx}")"
                               checked="@selectedForRun.Contains(t.Source)"
                               @onchange="@(e => ToggleSelectForRun(t.Source, e))" />
                        <label class="form-check-label visually-hidden" for="@($"sel_{idx}")">Seleccionar @t.Source</label>
                    </div>
                    <div class="flex-grow-1">
                        <span class="@(RegistryCssForMapping(t) ?? "")"><strong>@t.Source</strong></span>
                        <span class="text-muted">→</span>
                        <span class="@(RegistryCssForMapping(t) ?? "")"><strong>@t.Target</strong></span>
                        <span class="badge bg-secondary ms-2">@t.Mode</span>
                        <div class="small text-muted">@t.Columns.Count columnas · @(t.Columns.Count(c => !string.IsNullOrWhiteSpace(c.SourceExpression))) con transformación SQL · claves: @(t.KeyColumns.Count == 0 ? "—" : string.Join(", ", t.KeyColumns))@(IdentityOptionsSuffix(t))</div>
                        @if (lastRunBySource.TryGetValue(t.Source, out var st))
                        {
                            <div class="small @(st.Success ? "text-success" : "text-danger")">
                                Última ejecución: @(st.DryRun ? "dry-run" : "real") · @(st.Success ? "OK" : "Error")
                                · @st.At.ToLocalTime().ToString("g")
                                @if (!string.IsNullOrEmpty(st.Message))
                                {
                                    <span> — @st.Message</span>
                                }
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveTable(t)">Eliminar</button>
                </div>
            </li>
        }
    </ul>
}

@if (plan.Tables.Count > 0)
{
    <div class="card border-primary mb-4">
        <div class="card-header bg-primary text-white">Ejecutar migración (API)</div>
        <div class="card-body">
            <p class="small text-muted mb-2">
                <strong>Dry-run</strong>: solo cuenta filas y valida conexión (no escribe). <strong>Real</strong>: modifica el destino según el modo de cada tabla.
                Puedes enviar <strong>varias tablas en un solo POST</strong> (lote) o <strong>una petición por tabla</strong> (uno a uno).
            </p>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-info" @onclick="() => ExecuteBatchAsync(true)" disabled="@ExecuteDisabled">Dry-run (lote)</button>
                <button type="button" class="btn btn-outline-info" @onclick="() => ExecuteSequentialAsync(true)" disabled="@ExecuteDisabled">Dry-run (uno a uno)</button>
                <button type="button" class="btn btn-danger" @onclick="() => ExecuteBatchAsync(false)" disabled="@ExecuteDisabled">Ejecutar real (lote)</button>
                <button type="button" class="btn btn-danger" @onclick="() => ExecuteSequentialAsync(false)" disabled="@ExecuteDisabled">Ejecutar real (uno a uno)</button>
            </div>
            <p class="small mt-2 mb-0">
                También puedes llamar al API con <code>POST /api/migration/execute?dryRun=false</code> y el mismo cuerpo JSON que exportas.
            </p>
        </div>
    </div>
}

<RegistryWorkPlanPanel Host="registry" Plan="plan" PlanTableCount="plan.Tables.Count" SourceKindLabel="PostgreSQL"
                     OnLoadTableFromProgress="OnLoadTableFromRegistryProgressAsync" />

<div class="card mb-4">
    <div class="card-header">Snapshots en este navegador</div>
    <div class="card-body">
        <p class="small text-muted">Copia de seguridad del plan + bitácora reciente de ejecuciones al guardar. No sustituye Git ni un servidor de configuración.</p>
        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-6">
                <label class="form-label">Nombre del snapshot</label>
                <InputText class="form-control" @bind-Value="snapshotName" placeholder="p. ej. Antes de migrar clientes" />
            </div>
            <div class="col-md-6">
                <button type="button" class="btn btn-primary" @onclick="SaveSnapshotAsync" disabled="@(plan.Tables.Count == 0 || string.IsNullOrWhiteSpace(snapshotName))">Guardar snapshot</button>
            </div>
        </div>
        @if (snapshots.Count == 0)
        {
            <p class="text-muted small mb-0">No hay snapshots guardados.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var s in snapshots.OrderByDescending(x => x.SavedAt))
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <strong>@s.Name</strong>
                            <span class="text-muted small">· @s.SavedAt.ToLocalTime().ToString("g") · @s.Plan.Tables.Count tabla(s)</span>
                        </div>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => LoadSnapshotAsync(s.Id)">Cargar</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSnapshotAsync(s.Id)">Eliminar</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-2">
    <button type="button" class="btn btn-success" @onclick="DownloadPlan" disabled="@(plan.Tables.Count == 0)">Descargar mapeo.json</button>
    <label class="btn btn-outline-primary mb-0">
        Importar JSON
        <InputFile OnChange="OnImportJson" accept=".json,application/json" class="d-none" />
    </label>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-info mt-2" style="white-space: pre-wrap;">@statusMessage</div>
}

@code {
    private const string SnapshotsKey = "migrator.postgresql.snapshots.v1";
    private const string RunStateKey = "migrator.postgresql.runstate.v1";
    private const string SavedConnectionsKey = "migrator.savedConnections.v1";
    private const string RegistryWorkPlanIdKey = "migrator.registryActiveWorkPlanId.v1.postgresql";
    private const string RegistryPageExpectedSourceKind = "postgresql";

    private static readonly JsonSerializerOptions JsonRead = new() { PropertyNameCaseInsensitive = true };
    private static readonly JsonSerializerOptions JsonWrite = new() { WriteIndented = false };
    private static readonly JsonSerializerOptions JsonExportPretty = new() { WriteIndented = true, PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    private static readonly JsonSerializerOptions JsonStorageConnections = new() { WriteIndented = false, PropertyNamingPolicy = JsonNamingPolicy.CamelCase };

    private readonly MigrationPlan plan = new()
    {
        SourceKind = "postgresql",
        PostgreSqlSource = new PostgreSqlConnectionInfo(),
        Source = new SqlServerConnectionInfo(),
    };

    private IEnumerable<SavedConnectionEntry> PostgreSqlSavedConnections =>
        savedConnections.Where(IsPostgreSqlSaved).OrderByDescending(x => x.LastUsedAt);

    private IEnumerable<SavedConnectionEntry> SqlServerSavedConnections =>
        savedConnections.Where(IsSqlServerSaved).OrderByDescending(x => x.LastUsedAt);

    private static bool IsPostgreSqlSaved(SavedConnectionEntry x) =>
        string.Equals(x.Kind, "postgresql", StringComparison.OrdinalIgnoreCase);

    private static bool IsSqlServerSaved(SavedConnectionEntry x) =>
        string.Equals(x.Kind, "sqlServer", StringComparison.OrdinalIgnoreCase);

    private static string SavedConnectionKindLabel(SavedConnectionEntry s) =>
        string.Equals(s.Kind, "postgresql", StringComparison.OrdinalIgnoreCase) ? "PostgreSQL"
        : string.Equals(s.Kind, "mySql", StringComparison.OrdinalIgnoreCase) ? "MySQL"
        : string.Equals(s.Kind, "oracle", StringComparison.OrdinalIgnoreCase) ? "Oracle"
        : "SQL Server";

    private static string SavedConnectionServer(SavedConnectionEntry s)
    {
        if (string.Equals(s.Kind, "postgresql", StringComparison.OrdinalIgnoreCase) && s.PostgreSql is not null)
        {
            return $"{s.PostgreSql.Server}:{s.PostgreSql.Port}";
        }

        if (string.Equals(s.Kind, "mySql", StringComparison.OrdinalIgnoreCase) && s.MySql is not null)
        {
            return $"{s.MySql.Server}:{s.MySql.Port}";
        }

        if (string.Equals(s.Kind, "oracle", StringComparison.OrdinalIgnoreCase) && s.Oracle is not null)
        {
            return $"{s.Oracle.Server}:{s.Oracle.Port}";
        }

        return s.Connection?.Server ?? "—";
    }

    private static string SavedConnectionDatabase(SavedConnectionEntry s)
    {
        if (string.Equals(s.Kind, "postgresql", StringComparison.OrdinalIgnoreCase) && s.PostgreSql is not null)
        {
            return s.PostgreSql.Database;
        }

        if (string.Equals(s.Kind, "mySql", StringComparison.OrdinalIgnoreCase) && s.MySql is not null)
        {
            return s.MySql.Database;
        }

        if (string.Equals(s.Kind, "oracle", StringComparison.OrdinalIgnoreCase) && s.Oracle is not null)
        {
            return s.Oracle.ServiceName;
        }

        return s.Connection?.Database ?? "—";
    }

    private List<SchemaTableDto> sourceTables = new();
    private List<SchemaTableDto> targetTables = new();
    private List<SchemaColumnDto> sourceColumns = new();
    private List<SchemaColumnDto> targetColumns = new();

    private string? sourceLoadError;
    private string? targetLoadError;

    private string draftSource = string.Empty;
    private string draftTarget = string.Empty;
    private string draftMode = "insert";
    private string draftKeys = string.Empty;
    private bool draftReseedToZero;
    private bool draftPreserveIdentityValues;

    private readonly List<ColumnRow> columnRows = new() { new() };

    private string? statusMessage;

    private readonly HashSet<string> selectedForRun = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, TableRunState> lastRunBySource = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<TableRunLogEntry> sessionRunLog = new();

    private List<PlanSnapshotEnvelope> snapshots = new();
    private string snapshotName = string.Empty;
    private bool storageLoaded;

    private readonly RegistryMappingHost registry = new();
    private string? activeSourceConnectionId;
    private string? activeTargetConnectionId;

    private List<SavedConnectionEntry> savedConnections = new();
    private string newPresetNameSource = string.Empty;
    private string newPresetNameTarget = string.Empty;

    private bool ExecuteDisabled => selectedForRun.Count == 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || storageLoaded)
        {
            return;
        }

        storageLoaded = true;
        registry.Configure(HttpFactory, Js, RegistryWorkPlanIdKey, RegistryPageExpectedSourceKind);
        registry.SetStatusMessage = msg => { statusMessage = msg; };
        registry.NotifyStateChanged = () => InvokeAsync(StateHasChanged);
        registry.ApplyPlanDetail = ApplyRegistryPlanDetailAsync;
        await LoadBrowserStorageAsync();
        await registry.LoadActiveIdFromStorageAsync();
        await registry.RefreshRemoteAsync();
        StateHasChanged();
    }

    private async Task ApplyRegistryPlanDetailAsync(RegistryWorkPlanDetailDto detail)
    {
        var p = MigrationPlanJson.Deserialize(MigrationPlanJson.Serialize(detail.Plan));
        plan.SourceKind = "postgresql";
        plan.PostgreSqlSource = p.PostgreSqlSource is null ? new PostgreSqlConnectionInfo() : ClonePostgreSql(p.PostgreSqlSource);
        plan.Source = p.Source ?? new SqlServerConnectionInfo();
        plan.Target = p.Target ?? new SqlServerConnectionInfo();
        plan.MySqlSource = null;
        plan.OracleSource = null;
        plan.Tables.Clear();
        plan.Tables.AddRange(p.Tables);
        registry.SourceConnectionId = detail.Summary.SourceConnectionId ?? activeSourceConnectionId;
        registry.TargetConnectionId = detail.Summary.TargetConnectionId ?? activeTargetConnectionId;
        activeSourceConnectionId = registry.SourceConnectionId;
        activeTargetConnectionId = registry.TargetConnectionId;
        selectedForRun.Clear();
        foreach (var t in plan.Tables)
        {
            selectedForRun.Add(t.Source);
        }

        sourceTables = new List<SchemaTableDto>();
        targetTables = new List<SchemaTableDto>();
        sourceColumns = new List<SchemaColumnDto>();
        targetColumns = new List<SchemaColumnDto>();
        await Task.CompletedTask;
    }

    private async Task LoadBrowserStorageAsync()
    {
        try
        {
            var snapRaw = await Js.InvokeAsync<string?>("migratorLocalStorage.getItem", SnapshotsKey);
            if (!string.IsNullOrWhiteSpace(snapRaw))
            {
                snapshots = JsonSerializer.Deserialize<List<PlanSnapshotEnvelope>>(snapRaw, JsonRead) ?? new List<PlanSnapshotEnvelope>();
            }

            var runRaw = await Js.InvokeAsync<string?>("migratorLocalStorage.getItem", RunStateKey);
            if (!string.IsNullOrWhiteSpace(runRaw))
            {
                var dict = JsonSerializer.Deserialize<Dictionary<string, TableRunState>>(runRaw, JsonRead);
                if (dict is not null)
                {
                    foreach (var kv in dict)
                    {
                        lastRunBySource[kv.Key] = kv.Value;
                    }
                }
            }

            var connRaw = await Js.InvokeAsync<string?>("migratorLocalStorage.getItem", SavedConnectionsKey);
            if (!string.IsNullOrWhiteSpace(connRaw))
            {
                var envelope = JsonSerializer.Deserialize<SavedConnectionsFile>(connRaw, JsonRead);
                if (envelope?.Connections is { Count: > 0 })
                {
                    savedConnections = envelope.Connections;
                    NormalizeSavedConnectionKinds();
                }
            }

        }
        catch
        {
            /* localStorage puede fallar en modo privado */
        }
    }

    private async Task PersistSnapshotsAsync()
    {
        var json = JsonSerializer.Serialize(snapshots, JsonWrite);
        await Js.InvokeVoidAsync("migratorLocalStorage.setItem", SnapshotsKey, json);
    }

    private async Task PersistRunStateAsync()
    {
        var json = JsonSerializer.Serialize(lastRunBySource, JsonWrite);
