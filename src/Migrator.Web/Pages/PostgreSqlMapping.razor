    private async Task OnApplySourcePreset(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(id))
        {
            return;
        }

        var entry = savedConnections.FirstOrDefault(x => x.Id == id);
        if (entry is null || entry.PostgreSql is null)
        {
            return;
        }

        plan.PostgreSqlSource = ClonePostgreSql(entry.PostgreSql);
        activeSourceConnectionId = entry.Id;
        registry.SourceConnectionId = entry.Id;
        entry.LastUsedAt = DateTimeOffset.UtcNow;
        await PersistSavedConnectionsAsync();
        statusMessage = $"Origen rellenado desde: {entry.Name}";
    }

    private async Task OnApplyTargetPreset(ChangeEventArgs e)
    {
