    private async Task SaveSourceAsPresetAsync()
    {
        var m = plan.PostgreSqlSource;
        if (m is null
            || string.IsNullOrWhiteSpace(m.Server)
            || string.IsNullOrWhiteSpace(m.Database)
            || string.IsNullOrWhiteSpace(m.UserId))
        {
            statusMessage = "Indica host, base de datos y usuario PostgreSQL antes de guardar.";
            return;
        }

        activeSourceConnectionId = UpsertPostgreSqlConnectionFromUsage(m, string.IsNullOrWhiteSpace(newPresetNameSource) ? null : newPresetNameSource.Trim());
        registry.SourceConnectionId = activeSourceConnectionId;
        newPresetNameSource = string.Empty;
        await PersistSavedConnectionsAsync();
        statusMessage = "Conexión de origen guardada en la biblioteca.";
    }

