    }

    private async Task PersistSavedConnectionsAsync()
    {
        var file = new SavedConnectionsFile { Connections = savedConnections };
        var json = JsonSerializer.Serialize(file, JsonStorageConnections);
        await Js.InvokeVoidAsync("migratorLocalStorage.setItem", SavedConnectionsKey, json);
    }

    private void NormalizeSavedConnectionKinds()
    {
        foreach (var c in savedConnections)
        {
            if (!string.IsNullOrWhiteSpace(c.Kind))
            {
                continue;
            }

            c.Kind = c.Oracle is not null
                     && !string.IsNullOrWhiteSpace(c.Oracle.Server)
                     && !string.IsNullOrWhiteSpace(c.Oracle.ServiceName)
                ? "oracle"
                : c.PostgreSql is not null && !string.IsNullOrWhiteSpace(c.PostgreSql.Server)
                    ? "postgresql"
                : c.MySql is not null && !string.IsNullOrWhiteSpace(c.MySql.Server)
                    ? "mySql"
                    : "sqlServer";
        }
    }

    private string? UpsertConnectionFromUsage(SqlServerConnectionInfo info, string? preferredName = null)
    {
        if (string.IsNullOrWhiteSpace(info.Server) || string.IsNullOrWhiteSpace(info.Database))
        {
            return null;
        }

        var fp = SavedConnectionFingerprint.Of(info);
        var existing = savedConnections.FirstOrDefault(x =>
            IsSqlServerSaved(x)
            && x.Connection is not null
            && SavedConnectionFingerprint.Of(x.Connection) == fp);
        if (existing is not null)
        {
            existing.Kind = "sqlServer";
            existing.Connection = CloneConn(info);
            existing.MySql = null;
            existing.Oracle = null;
            existing.PostgreSql = null;
            existing.LastUsedAt = DateTimeOffset.UtcNow;
            if (!string.IsNullOrWhiteSpace(preferredName))
            {
                existing.Name = preferredName.Trim();
            }

            return existing.Id;
        }

        var name = !string.IsNullOrWhiteSpace(preferredName)
            ? preferredName!.Trim()
            : $"{info.Server.Trim()} · {info.Database.Trim()}";

        var sqlEntry = new SavedConnectionEntry
        {
            Kind = "sqlServer",
            Name = name,
            Connection = CloneConn(info),
            MySql = null,
            Oracle = null,
            PostgreSql = null,
            LastUsedAt = DateTimeOffset.UtcNow,
        };
        savedConnections.Add(sqlEntry);
        return sqlEntry.Id;
    }

    private static string FormatSavedConnectionLabel(SavedConnectionEntry s)
    {
        if (string.Equals(s.Kind, "postgresql", StringComparison.OrdinalIgnoreCase) && s.PostgreSql is not null)
        {
            return $"{s.Name} ({s.PostgreSql.Server}:{s.PostgreSql.Port} · {s.PostgreSql.Database})";
        }

        if (string.Equals(s.Kind, "mySql", StringComparison.OrdinalIgnoreCase) && s.MySql is not null)
        {
            return $"{s.Name} ({s.MySql.Server}:{s.MySql.Port} · {s.MySql.Database})";
        }

        if (string.Equals(s.Kind, "oracle", StringComparison.OrdinalIgnoreCase) && s.Oracle is not null)
        {
            return $"{s.Name} ({s.Oracle.Server}:{s.Oracle.Port} · {s.Oracle.ServiceName})";
        }

        if (s.Connection is not null)
        {
            return $"{s.Name} ({s.Connection.Server} · {s.Connection.Database})";
        }

        return s.Name;
    }

    private string? UpsertPostgreSqlConnectionFromUsage(PostgreSqlConnectionInfo info, string? preferredName = null)
    {
        if (string.IsNullOrWhiteSpace(info.Server) || string.IsNullOrWhiteSpace(info.Database))
        {
            return null;
        }

        var fp = SavedConnectionFingerprint.Of(info);
        var existing = savedConnections.FirstOrDefault(x =>
            IsPostgreSqlSaved(x)
            && x.PostgreSql is not null
            && SavedConnectionFingerprint.Of(x.PostgreSql) == fp);

        if (existing is not null)
        {
            existing.Kind = "postgresql";
            existing.PostgreSql = ClonePostgreSql(info);
            existing.Connection = null;
            existing.MySql = null;
            existing.Oracle = null;
            existing.LastUsedAt = DateTimeOffset.UtcNow;
            if (!string.IsNullOrWhiteSpace(preferredName))
            {
                existing.Name = preferredName.Trim();
            }

            return existing.Id;
        }

        var name = !string.IsNullOrWhiteSpace(preferredName)
            ? preferredName!.Trim()
            : $"{info.Server.Trim()}:{info.Port} · {info.Database.Trim()}";

        var entry = new SavedConnectionEntry
        {
            Kind = "postgresql",
            Name = name,
            Connection = null,
            MySql = null,
            Oracle = null,
            PostgreSql = ClonePostgreSql(info),
            LastUsedAt = DateTimeOffset.UtcNow,
        };
        savedConnections.Add(entry);
        return entry.Id;
    }

    private static PostgreSqlConnectionInfo ClonePostgreSql(PostgreSqlConnectionInfo c) =>
        new()
        {
            Server = c.Server,
            Port = c.Port is >= 1 and <= 65535 ? c.Port : 5432,
            Database = c.Database,
            UserId = c.UserId,
            Password = c.Password,
        };

