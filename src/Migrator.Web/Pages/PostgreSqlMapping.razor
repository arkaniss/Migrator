    private async Task OnImportConnectionsJson(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 512 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var imported = JsonSerializer.Deserialize<SavedConnectionsFile>(json, JsonRead);
            if (imported?.Connections is null || imported.Connections.Count == 0)
            {
                statusMessage = "El archivo no contiene conexiones válidas.";
                return;
            }

            foreach (var row in imported.Connections)
            {
                NormalizeImportedConnectionRow(row);
                if (string.Equals(row.Kind, "postgresql", StringComparison.OrdinalIgnoreCase) && row.PostgreSql is not null)
                {
                    UpsertPostgreSqlConnectionFromUsage(row.PostgreSql, string.IsNullOrWhiteSpace(row.Name) ? null : row.Name.Trim());
                }
                else if (string.Equals(row.Kind, "mySql", StringComparison.OrdinalIgnoreCase) && row.MySql is not null)
                {
                    UpsertMySqlConnectionFromUsage(row.MySql, string.IsNullOrWhiteSpace(row.Name) ? null : row.Name.Trim());
                }
                else if (string.Equals(row.Kind, "oracle", StringComparison.OrdinalIgnoreCase) && row.Oracle is not null)
                {
                    UpsertOracleConnectionFromUsage(row.Oracle, string.IsNullOrWhiteSpace(row.Name) ? null : row.Name.Trim());
                }
                else if (row.Connection is not null)
                {
                    row.Kind = "sqlServer";
                    UpsertConnectionFromUsage(row.Connection, string.IsNullOrWhiteSpace(row.Name) ? null : row.Name.Trim());
                }
            }

            await PersistSavedConnectionsAsync();
            statusMessage = $"Importadas/actualizadas conexiones desde archivo ({savedConnections.Count} en biblioteca).";
        }
        catch (Exception ex)
        {
            statusMessage = "Importar conexiones: " + ex.Message;
        }
    }

    private static void NormalizeImportedConnectionRow(SavedConnectionEntry row)
    {
        if (string.IsNullOrWhiteSpace(row.Kind))
        {
            row.Kind = row.Oracle is not null
                     && !string.IsNullOrWhiteSpace(row.Oracle.Server)
                     && !string.IsNullOrWhiteSpace(row.Oracle.ServiceName)
                ? "oracle"
                : row.PostgreSql is not null && !string.IsNullOrWhiteSpace(row.PostgreSql.Server)
                    ? "postgresql"
                : row.MySql is not null && !string.IsNullOrWhiteSpace(row.MySql.Server)
                    ? "mySql"
                    : "sqlServer";
        }
    }

